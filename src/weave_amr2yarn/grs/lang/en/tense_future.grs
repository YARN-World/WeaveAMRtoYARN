package tense_future {
  rule mark_future_modal {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB"];
          token -[aux]-> token2;
          token2 [lemma = "will"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "future";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_future_periphrastic {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", VerbForm="Inf"|"Part"];
          token2 -[xcomp]-> token;
          token2 [lemma = "go", Tense="Pres", VerbForm="Part"];
          token2 -[aux]-> token3;
          token3 [lemma="be", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "future";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }
}
