  }

  rule mark_present_progressive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", Tense="Pres", VerbForm="Part"]|[upos="VERB", VerbForm="Ger"];
          token -[aux]-> token2;
          token2 [lemma = "be", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "present, future";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_present_anterior {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", Tense="Past", VerbForm="Part"];
          token -[aux]-> token2;
          token2 [lemma = "have", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_present_anterior_progressive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", Tense="Pres", VerbForm="Part"];
          token -[aux]-> token2;
          token2 [lemma = "have", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "continuative";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  % Passive forms.

  % Every passive rule below carries the same locational guard.
  %
  % Where the node is the argument of a reified locational frame, the copula
  % on its anchor belongs to the frame rather than to it, and the locational
  % rules further down attach the tense there instead.
  %
  % The guard is repeated in each rule rather than factored out. Grew has no
  % way to share a `without` block, and inlining at least keeps every rule
  % readable on its own.

  rule mark_past_simple_passive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]->token;
          token [Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      without {
          predicate [pred="locate-01"|"originate-01"];
          predicate -[ARG2]-> node
      }
      % A bare-concept copular carries a domain relation, and its tense
      % belongs on that relation rather than on the concept. The copula was
      % rewritten into a passive auxiliary, so without this guard the passive
      % rules below would fire on it a second time.
      without {
          relation [rel="domain", type="E"];
          node -> relation
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_past_progressive_passive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]->token;
          token [Tense="Pres", VerbForm="Part"];
          node2 -[aux]-> token2;
          token2 [lemma = "be", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      without {
          predicate [pred="locate-01"|"originate-01"];
          predicate -[ARG2]-> node
      }
      % A bare-concept copular carries a domain relation, and its tense
      % belongs on that relation rather than on the concept. The copula was
      % rewritten into a passive auxiliary, so without this guard the passive
      % rules below would fire on it a second time.
      without {
          relation [rel="domain", type="E"];
          node -> relation
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_past_anterior_passive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]->token;
          token [Tense="Pres"|"Past", VerbForm="Part"];
          node2 -[aux]-> token2;
          token2 [lemma = "have", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
