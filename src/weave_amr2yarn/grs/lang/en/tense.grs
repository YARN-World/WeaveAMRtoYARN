  rule mark_present_anterior_progressive_passive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]->token;
          token [Tense="Pres", VerbForm="Part"];
          node2 -[aux]-> token2;
          token2 [lemma = "have", Tense="Pres", VerbForm="Fin"];
