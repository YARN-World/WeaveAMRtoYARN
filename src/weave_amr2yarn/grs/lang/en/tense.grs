          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_present_simple {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", VerbForm="Inf"];
