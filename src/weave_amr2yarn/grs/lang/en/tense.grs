package tense {
  % Indicative forms.

  rule mark_tense_from_amr {
      pattern {
          event [type="S"];
          event -[link]-> predicate;
          predicate [pred];
          arc:predicate -[time]-> node;
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [value="_", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          del_edge arc;
          add_node tempValue;
          tempValue.value = "_";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc2:tempSlot->tempValue;
          add_edge arc3:tempValue->node
      }
  }

  rule mark_past_simple_asserted {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot;
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue2;
          tempValue2.value = "past";
          tempValue2.type = "L";
          tempValue2.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue2;
          add_edge arc2:tempValue2->node
      }
  }

  rule mark_past_simple {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", VerbForm="Inf"];
          token -[aux]->token2;
          token2 [lemma="do", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot;
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  % "used to" — the past habitual.
  %
  % Gated tightly, because "use" is an ordinary verb too. The construction
  % needs a past-tense "use" heading a bare infinitive through an open
  % complement; instrumental "use" takes an object and an adverbial clause
  % instead, so it never matches. Requiring past tense also keeps out the
  % present, which is not English.
  rule mark_past_habitual {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", VerbForm="Inf"];
          token2 -[xcomp]-> token;
          token2 [lemma="use", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_past_progressive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", Tense="Pres", VerbForm="Part"];
          token -[aux]-> token2;
          token2 [lemma = "be", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_past_anterior {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="VERB", Tense="Pres"|"Past", VerbForm="Part"];
          token -[aux]-> token2;
          token2 [lemma = "have", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      commands {
