  % The locational frames have no word of their own in the sentence, so the
  % copula turns up on their argument. These two mirror the passive shape but
  % reach it through the argument, and put the tense on the predicate.

  rule mark_present_simple_locative {
      pattern {
          event [type="S"];
          event -[link]-> predicate;
          predicate [pred="locate-01"|"originate-01"];
          predicate -[ARG2]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]-> token;
          token [lemma="be", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->predicate
      }
      commands {
          add_node tempValue;
          tempValue.value = "present";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->predicate
      }
  }

  rule mark_past_simple_locative {
      pattern {
          event [type="S"];
          event -[link]-> predicate;
          predicate [pred="locate-01"|"originate-01"];
          predicate -[ARG2]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]-> token;
          token [lemma="be", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->predicate
      }
      commands {
          add_node tempValue;
          tempValue.value = "past";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->predicate
      }
  }

  % Reading tense straight off an auxiliary.
  %
  % Where a predicate anchors to a finite auxiliary or copula rather than to
  % a lexical verb, that token is all there is to read. This covers frames
  % with no word of their own, whose anchor ends up on the copula, and
  % do-support.
  %
  % Restricted to the three auxiliary lemmas: "will" belongs to the future
  % package, and modals carry no tense of their own to give.
  %
  % It cannot collide with the rules above. Those all require a verb on the
  % anchor, and the guard below keeps this one out of periphrastic forms —
  % "has finished", "did go" — where the verb is what carries the tense. The
  % passive auxiliary is deliberately left unguarded, since the copula is
  % rewritten into one and copular anchors are this rule's main business.

  rule mark_past_simple_auxiliary {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="AUX", lemma="be"|"have"|"do", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot;
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      without { node2 -[aux]-> token }
      commands {
          add_node tempValue2;
          tempValue2.value = "past";
          tempValue2.type = "L";
          tempValue2.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue2;
          add_edge arc2:tempValue2->node
      }
  }

  rule mark_present_simple_auxiliary {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> token;
          token [upos="AUX", lemma="be"|"have"|"do", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot;
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->node
      }
      without { node2 -[aux]-> token }
      commands {
          add_node tempValue2;
          tempValue2.value = "present";
          tempValue2.type = "L";
          tempValue2.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue2;
          add_edge arc2:tempValue2->node
      }
  }

  % Copular forms.

  rule mark_past_simple_copular {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node2 [rel="domain"];
          node->node2;
          node -[anchor]-> node3;
          node3 -[aux:pass]->token;
          token [Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          hyperedge [feat="temp", type="H"];
          tempSlot->hyperedge;
          hyperedge->node2
      }
      commands {
          add_node hyperedge;
          hyperedge.value = "past";
          hyperedge.type = "H";
          hyperedge.feat = tempSlot.feat;
          add_edge arc:tempSlot->hyperedge;
          add_edge arc2:hyperedge->node2
      }
  }

  rule mark_past_progressive_copular {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node2 [rel="domain"];
          node->node2;
          node -[anchor]-> node3;
          node3 -[aux:pass]->token;
          token [Tense="Pres", VerbForm="Part"];
          node3 -[aux]-> token2;
          token2 [lemma = "be", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          hyperedge [feat="temp", type="H"];
          tempSlot->hyperedge;
          hyperedge->node2
      }
      commands {
          add_node hyperedge;
          hyperedge.value = "past";
          hyperedge.type = "H";
          hyperedge.feat = tempSlot.feat;
          add_edge arc:tempSlot->hyperedge;
          add_edge arc2:hyperedge->node2
      }
  }

  rule mark_past_anterior_copular {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node2 [rel="domain"];
          node->node2;
          node -[anchor]-> node3;
          node3 -[aux:pass]->token;
          token [Tense="Pres"|"Past", VerbForm="Part"];
          node3 -[aux]-> token2;
          token2 [lemma = "have", Tense="Past", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          hyperedge [feat="temp", type="H"];
          tempSlot->hyperedge;
          hyperedge->node2
