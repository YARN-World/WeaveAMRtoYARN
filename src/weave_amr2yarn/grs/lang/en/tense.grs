  rule mark_present_progressive_copular {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node2 [rel="domain"];
          node->node2;
          node -[anchor]-> node3;
          node3 -[aux:pass]->token;
          token [Tense="Pres", VerbForm="Part"]|[upos="VERB", VerbFrom="Ger"];
          node3 -[aux]-> token2;
          token2 [lemma = "be", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          hyperedge [feat="temp", type="H"];
          tempSlot->hyperedge;
          hyperedge->node2
      }
      commands {
          add_node hyperedge;
          hyperedge.value = "present";
          hyperedge.type = "H";
          hyperedge.feat = tempSlot.feat;
          add_edge arc:tempSlot->hyperedge;
          add_edge arc2:hyperedge->node2
      }
  }

  rule mark_present_anterior_copular {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node2 [rel="domain"];
          node->node2;
          node -[anchor]-> node3;
          node3 -[aux:pass]->token;
          token [Tense="Past", VerbForm="Part"];
          node3 -[aux]-> token2;
          token2 [lemma = "have", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          hyperedge [feat="temp", type="H"];
          tempSlot->hyperedge;
          hyperedge->node2
      }
      commands {
          add_node hyperedge;
          hyperedge.value = "continuative, past";
          hyperedge.type = "H";
          hyperedge.feat = tempSlot.feat;
          add_edge arc:tempSlot->hyperedge;
          add_edge arc2:hyperedge->node2
      }
  }

  rule mark_present_anterior_progressive_copular {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node2 [rel="domain"];
          node->node2;
          node -[anchor]-> node3;
          node3 -[aux:pass]->token;
          token [Tense="Pres", VerbForm="Part"];
          node3 -[aux]-> token2;
          token2 [lemma = "have", Tense="Pres", VerbForm="Fin"];
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          hyperedge [feat="temp", type="H"];
          tempSlot->hyperedge;
          hyperedge->node2
      }
      commands {
          add_node hyperedge;
          hyperedge.value = "continuative";
          hyperedge.type = "H";
          hyperedge.feat = tempSlot.feat;
          add_edge arc:tempSlot->hyperedge;
          add_edge arc2:hyperedge->node2
      }
  }

  % Still open: copulars with a predicate, and modifiers.

  % Imperative.
  rule mark_imperative {
      pattern {
          event [type="S"];
          predicate [pred];
          event -[link]-> predicate;
          moodSlot [feat="mood", type="F"];
          layerValue [value="imperative", type="L"];
          event -> moodSlot;
          moodSlot -> layerValue;
          layerValue -> predicate;
          tempSlot [feat="temp", type="F"];
          event->tempSlot
      }
      without {
          tempValue [feat="temp", type="L"];
          tempSlot->tempValue;
          tempValue->predicate
      }
      commands {
          add_node tempValue;
          tempValue.value = "present";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc: tempSlot->tempValue;
          add_edge arc2: tempValue->predicate
      }
  }

