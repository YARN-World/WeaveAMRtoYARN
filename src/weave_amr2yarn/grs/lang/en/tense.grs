          tempValue.value = "present";
          tempValue.type = "L";
          tempValue.feat = tempSlot.feat;
          add_edge arc:tempSlot->tempValue;
          add_edge arc2:tempValue->node
      }
  }

  rule mark_present_anterior_passive {
      pattern {
          event [type="S"];
          event -[link]-> node;
          node -[anchor]-> node2;
          node2 -[aux:pass]->token;
          token [Tense="Past", VerbForm="Part"];
          node2 -[aux]-> token2;
          token2 [lemma = "have", Tense="Pres", VerbForm="Fin"];
