  rule grade_plain_predicate {
      pattern {
          event [type="S"];
          degreeSlot [feat="degree", type="F"];
          event->degreeSlot;
          predicate [pred];
          event -[link]-> predicate;
          arc:predicate -[degree]->predicate2;
          predicate2 [pred]
      }
      commands {
          add_node degreeValue;
          degreeValue.value = "_";
          degreeValue.type = "L";
          degreeValue.feat = degreeSlot.feat;
          add_edge arc2: degreeSlot->degreeValue;
          add_edge arc3: degreeValue->predicate2;
          del_edge arc
      }

  }
}
