  }

  rule localize_ordering_main {
      pattern {
          predicate [pred];
          conceptNode [concept="before"|"after"];
          predicate -[time]-> conceptNode;
          conceptNode -[op1]-> predicate2;
          predicate2 [pred]
      }
      without {
          event [type="S"];
          event -[link]-> predicate
      }
      commands {
          add_node event;
          event.event = "__S__";
          event.type = "S";
          event.src = "localize_ordering_main";
          event.core = predicate.var;
          add_edge event -[link]-> predicate;
