  rule localize_special_predicate {
      pattern {
          predicate [pred="locate-01"|"like-04"|"old-01"]|[pred=re".*-00"]
      }
      without {
          event [type="S"];
          event -[link]-> predicate
      }
      commands {
          add_node event;
          event.event = "__S__";
          event.type = "S";
          event.src = "localize_special_predicate";
          event.core = predicate.var;
          add_edge event-[link]->predicate
      }
  }
}
