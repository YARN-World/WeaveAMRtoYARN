  rule localize_condition_antecedent {
      pattern {
          predicate [pred];
          predicate -[condition]->node;
      }
      without {
          *-[link]->predicate;
      }
      commands {
          add_node event;
          event.event = "__S__";
          event.type = "S";
          event.src = "localize_condition_antecedent";
