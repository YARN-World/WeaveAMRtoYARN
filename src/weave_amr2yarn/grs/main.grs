        Onf (localize_orphans), %a node nothing localized borrows its child's event; ties are left alone
        Onf (localize_core), Onf (localize_events), %reach into whatever was just adopted
        Onf (skeleton),
        Onf (reference), %flags non-referential nominals, which the three nominal layers then skip
        Onf (distributivity), %ahead of modification/manner_layer/quantification, whose cues it eats
        Onf (duration),
        Onf (deixis), %ahead of modification
        Onf (modification),
        Onf (manner_layer),
        Onf (location),
        Onf (direction),
        Onf (definiteness),
        number.number_sequence, %ordered by hand: a fixed point lets the lexicon race the mass rules
        Onf (quantification_draft), %immediately before quantification, whose op1 subtrees it consumes
        Onf (quantification), %after number
        Onf (negation), %after quantification, so a negated quantifier has something to attach to
        Onf (degree),
        Onf (frequency),
        Onf (mood),
        Onf (question),
        Onf (tense_future), %ahead of tense: the periphrastic future is read off the auxiliary
        Onf (tense),
        Onf (tense_pending), %after tense, so it only fills what was left empty
        aspect.aspect_sequence,    %ordered by hand: a fixed point lets the lexical fallback outrun the constructions
        Onf (aspect_pending), %after aspect, so it only fills what was left empty
        Onf (modality),
        Onf (clause_links),
        Onf (hyperedge_draft), %resolve the drafted hyperedges, before hyperedges routes them
        Onf (hyperedges),
        Onf (focus), %after clause_links
        Onf (finalize_eval),
        Onf (finalize), %always last
    )
}

% eval with the reference pass taken out: nothing is ever flagged as
% non-referential, so the three nominal layers apply to every nominal.
% Kept to measure what that pass is worth.
strat eval_noref {
    Seq (
        Onf (canonicalize),
        Onf (dereification), %unfolds the reified -91 predicates back into plain relations
        Onf (predicate_repair),
        Onf (copula), %ahead of modal_verbs
        Onf (modal_verbs),
        Onf (inclusion),
        Onf (event_expansion),
        Onf (discourse), %after event_expansion
        Onf (discourse_links), %after discourse
        Onf (localize_core), Onf (localize_events),
        Onf (localize_core), Onf (localize_events), %again: an event minted since the first pass still needs its subtree
        Onf (event_recovery), %last resort: nothing became an event, so the AMR root is made one
        Onf (localize_core), Onf (localize_events), %give the recovered event its subtree
        Onf (localize_orphans), %a node nothing localized borrows its child's event; ties are left alone
        Onf (localize_core), Onf (localize_events), %reach into whatever was just adopted
        Onf (skeleton),
        Onf (distributivity), %ahead of modification/manner_layer/quantification, whose cues it eats
        Onf (duration),
        Onf (deixis), %ahead of modification
        Onf (modification),
        Onf (manner_layer),
        Onf (location),
        Onf (direction),
        Onf (definiteness),
        number.number_sequence, %ordered by hand: a fixed point lets the lexicon race the mass rules
        Onf (quantification), %after number
        Onf (negation), %after quantification, so a negated quantifier has something to attach to
        Onf (degree),
        Onf (frequency),
        Onf (mood),
        Onf (question),
        Onf (tense_future), %ahead of tense: the periphrastic future is read off the auxiliary
        Onf (tense),
        Onf (tense_pending), %after tense, so it only fills what was left empty
        aspect.aspect_sequence,    %ordered by hand: a fixed point lets the lexical fallback outrun the constructions
        Onf (aspect_pending), %after aspect, so it only fills what was left empty
        Onf (modality),
        Onf (clause_links),
        Onf (hyperedges),
        Onf (focus), %after clause_links
        Onf (finalize_eval),
        Onf (finalize), %always last
    )
}
