package skeleton {
  rule open_event_frame {
      without {
          event [type = "S"]
      }
      commands {
          add_node event;
          event.event = "S1";
          event.type = "S";
          event.src = "open_event_frame";
      }
  }

  % Also gives the concept its event link.
  rule bind_focus_concept {
      pattern {
          event [event="S1", type="S"];
          focusSlot [feat="focus", type="F"];
          event -> focusSlot;
          conceptNode [concept]
      }
      without {
          *->conceptNode
      }
      without {
          event-[link]->*
      }
      commands {
          add_node focusValue;
          focusValue.value = "_";
          focusValue.type = "L";
          focusValue.feat = focusSlot.feat;
          add_edge arc:focusSlot->focusValue;
          add_edge arc2:focusValue->conceptNode;
          add_edge event-[link]->conceptNode
      }
  }

  rule open_tense_slot {
      pattern {
          event [type = "S"]
      }
      without {
          tempSlot [feat = "temp", type = "F"];
          event->tempSlot
      }
      commands {
          add_node tempSlot;
          tempSlot.type = "F";
          tempSlot.feat = "temp";
          add_edge arc: event->tempSlot
      }
  }

  rule open_aspect_slot {
